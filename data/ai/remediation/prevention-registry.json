{
  "schema_version": 1,
  "rules": [
    {
      "prevention_id": "PREVENT-LOCAL-ISOLATION",
      "incident_family": "UNKNOWN_FAILURE",
      "rule": "LOCAL 장애는 영향 의존성만 격리하고 독립 작업과 다른 AI를 중단하지 않는다.",
      "monitor": "recovery scope/global stop reason",
      "regression_guard": "AGENTS.md + supervisor progression_policy"
    },
    {
      "prevention_id": "PREVENT-WRITER-UNTRACKED",
      "incident_family": "WRITE_FAILURE",
      "rule": "새 파일을 포함한 writer 변경은 git status --porcelain과 expected target 검증을 사용한다.",
      "monitor": "canonical-writer commit step",
      "regression_guard": "tests/test_writer.py"
    },
    {
      "prevention_id": "PREVENT-PAGES-ALL-PUSH",
      "incident_family": "PAGE_STALE",
      "rule": "Pages는 모든 main push를 관찰하고 fingerprint/display-layer 변경으로 배포 여부를 결정한다.",
      "monitor": "pages workflow + public verifier",
      "regression_guard": "Pages source/fingerprint/core-section verification"
    },
    {
      "prevention_id": "PREVENT-DISPLAY-MODULE",
      "incident_family": "PAGE_STALE",
      "rule": "pages.py뿐 아니라 pages_korean.py와 모든 test_pages 계열 변경도 display-layer 변경으로 간주한다.",
      "monitor": "pages impact gate",
      "regression_guard": "workflow path contract"
    },
    {
      "prevention_id": "PREVENT-RETRY-LOOP",
      "incident_family": "ACTION_FAILURE",
      "rule": "동일 실패 run은 자동 재실행을 1회만 수행하고 재실패하면 원인분석으로 승격한다.",
      "monitor": "workflow_run.run_attempt",
      "regression_guard": "self-heal workflow condition"
    },
    {
      "prevention_id": "PREVENT-LEASE-TAKEOVER",
      "incident_family": "LEASE_EXPIRED",
      "rule": "만료된 recovery/writer lease는 정상 소유 상태로 남기지 않고 takeover 대상으로 즉시 탐지한다.",
      "monitor": "services/recovery-queue/writer-lease lease_until",
      "regression_guard": "tests/test_remediation.py::test_expired_recovery_lease_is_detected"
    },
    {
      "prevention_id": "PREVENT-ACTION-STEP-EVIDENCE",
      "incident_family": "ACTION_FAILURE",
      "rule": "Actions 실패는 workflow 이름만 기록하지 않고 실패 job과 step을 snapshot evidence에 포함한다.",
      "monitor": "actions run jobs endpoint",
      "regression_guard": "tests/test_remediation.py::test_failed_job_summary_records_exact_step"
    },
    {
      "prevention_id": "PREVENT-REGISTRY-EXECUTABLE",
      "incident_family": "UNKNOWN_FAILURE",
      "rule": "error-signatures registry를 분류기의 실제 입력으로 사용하고 잘못된 regex/schema는 system-check에서 차단한다.",
      "monitor": "remediation registry validation",
      "regression_guard": "tests/test_remediation.py registry signature tests"
    },
    {
      "prevention_id": "PREVENT-SERVICE-MONITORING-MODE",
      "incident_family": "SERVICE_TELEMETRY_UNINITIALIZED",
      "rule": "EVENT_DRIVEN 서비스는 배포시각만으로 stale 처리하지 않고, DERIVED 서비스는 실제 하위 heartbeat 증거에서 상태를 계산한다.",
      "monitor": "supervisor monitoring_mode semantics",
      "regression_guard": "tests/test_supervisor.py event-driven and derived-heartbeat tests"
    }
  ]
}
