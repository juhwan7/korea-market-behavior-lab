{
  "schema_version": 1,
  "rules": [
    {
      "prevention_id": "PREVENT-LOCAL-ISOLATION",
      "incident_family": "UNKNOWN_FAILURE",
      "rule": "LOCAL 장애는 영향 의존성만 격리하고 독립 작업과 다른 AI를 중단하지 않는다.",
      "monitor": "recovery scope/global stop reason",
      "regression_guard": "AGENTS.md + supervisor progression_policy"
    },
    {
      "prevention_id": "PREVENT-WRITER-UNTRACKED",
      "incident_family": "WRITE_FAILURE",
      "rule": "새 파일을 포함한 writer 변경은 git status --porcelain과 expected target 검증을 사용한다.",
      "monitor": "canonical-writer commit step",
      "regression_guard": "tests/test_writer.py"
    },
    {
      "prevention_id": "PREVENT-PAGES-ALL-PUSH",
      "incident_family": "PAGE_STALE",
      "rule": "Pages는 모든 main push를 관찰하고 fingerprint/display-layer 변경으로 배포 여부를 결정한다.",
      "monitor": "pages workflow + public verifier",
      "regression_guard": "Pages source/fingerprint/core-section verification"
    },
    {
      "prevention_id": "PREVENT-DISPLAY-MODULE",
      "incident_family": "PAGE_STALE",
      "rule": "pages.py뿐 아니라 pages_korean.py와 모든 test_pages 계열 변경도 display-layer 변경으로 간주한다.",
      "monitor": "pages impact gate",
      "regression_guard": "workflow path contract"
    },
    {
      "prevention_id": "PREVENT-RETRY-LOOP",
      "incident_family": "ACTION_FAILURE",
      "rule": "동일 실패 run은 자동 재실행을 1회만 수행하고 재실패하면 원인분석으로 승격한다.",
      "monitor": "workflow_run.run_attempt",
      "regression_guard": "self-heal workflow condition"
    }
  ]
}
