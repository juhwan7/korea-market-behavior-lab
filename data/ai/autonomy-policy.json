{
  "schema_version": 2,
  "repository": "juhwan7/korea-market-behavior-lab",
  "autonomous_repository_writes": true,
  "approved_scope": [
    "create_files",
    "update_files",
    "delete_project_files_when_safe",
    "update_workflows",
    "add_tests",
    "update_docs",
    "update_machine_state",
    "commit_to_main"
  ],
  "require_human_for": [
    "secrets_or_oauth_changes",
    "billing_or_payment",
    "account_permissions",
    "repository_deletion",
    "history_destructive_force_operations",
    "credential_exposure"
  ],
  "retry_policy": {
    "stale_sha": "refetch_latest_sha_then_retry",
    "concurrent_edit": "rebase_or_refetch_then_apply_non_conflicting_change",
    "generic_write_guard": "record_incident_try_safe_alternate_path_and_keep_independent_work_running"
  },
  "blocking_states": [
    "blocked",
    "write_failed",
    "safety_guard_blocked",
    "stale_sha",
    "conflict",
    "timeout",
    "failed",
    "missing",
    "unapplied",
    "verification_pending",
    "human_required"
  ],
  "progression_rule": {
    "same_dependency_chain": "resolve_and_verify_before_promotion",
    "independent_work": "continue",
    "automation_state": "do_not_disable_for_local_blockers",
    "global_stop_only_for": [
      "canonical_corruption_propagation",
      "credential_exposure",
      "destructive_history_risk"
    ]
  },
  "recovery_sequence": [
    "inspect_real_error",
    "claim_recovery_lease",
    "refetch_latest_sha",
    "split_change",
    "use_non_conflicting_safe_path",
    "apply_tests_or_minimal_fix",
    "rerun",
    "verify_main_commit_and_actions",
    "resolve_incident",
    "resume_dependent_chain"
  ],
  "success_evidence": [
    "commit_sha",
    "actions_result",
    "expected_file_state"
  ],
  "failure_isolation": {
    "queue_path": "data/ai/recovery-queue.json",
    "preserve_service_liveness": true,
    "one_blocked_task_does_not_stop_all_agents": true
  }
}
