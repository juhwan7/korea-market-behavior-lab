{
  "schema_version": 1,
  "repository": "juhwan7/korea-market-behavior-lab",
  "autonomous_repository_writes": true,
  "approved_scope": [
    "create_files",
    "update_files",
    "delete_project_files_when_safe",
    "update_workflows",
    "add_tests",
    "update_docs",
    "update_machine_state",
    "commit_to_main"
  ],
  "require_human_for": [
    "secrets_or_oauth_changes",
    "billing_or_payment",
    "account_permissions",
    "repository_deletion",
    "history_destructive_force_operations",
    "credential_exposure"
  ],
  "retry_policy": {
    "stale_sha": "refetch_latest_sha_then_retry",
    "concurrent_edit": "rebase_or_refetch_then_apply_non_conflicting_change",
    "generic_write_guard": "do_not_stop_unless_external_permission_or_safety_constraint_is_real"
  },
  "blocking_states": [
    "blocked",
    "write_failed",
    "safety_guard_blocked",
    "stale_sha",
    "conflict",
    "timeout",
    "failed",
    "missing",
    "unapplied",
    "verification_pending",
    "human_required"
  ],
  "progression_rule": "resolve_and_verify_before_handoff_or_next_stage",
  "recovery_sequence": [
    "inspect_real_error",
    "refetch_latest_sha",
    "split_change",
    "use_non_conflicting_safe_path",
    "apply_tests_or_minimal_fix",
    "rerun",
    "verify_main_commit_and_actions",
    "resume_only_after_verified_recovery"
  ],
  "success_evidence": [
    "commit_sha",
    "actions_result",
    "expected_file_state"
  ]
}
